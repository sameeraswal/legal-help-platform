# Copy to deploy/.env and fill in real values before running docker-compose.

# --- Database ---
DB_NAME=legalhelp
DB_USER=legalhelp
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# --- Auth ---
# 32+ character random string
JWT_SECRET=change_me_to_a_long_random_string
# base64-encoded 32-byte (256-bit) key, e.g: openssl rand -base64 32
ENCRYPTION_KEY=

# --- LLM (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Ollama, LM Studio, ...) ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Only used when LLM_PROVIDER=openrouter; see openrouter.ai/docs for attribution headers.
LLM_OPENROUTER_REFERER=
LLM_OPENROUTER_TITLE=

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=